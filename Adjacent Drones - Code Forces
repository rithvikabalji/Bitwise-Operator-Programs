#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int n, k;
        cin >> n >> k;

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

  
        set<int> used;
        vector<int> b(n);

        for (int i = n - 1; i >= 0; i--) {
            int x = a[i];

            auto it = used.lower_bound(x);

            if (it != used.end() && *it == x) {
                while (used.count(x)) {
                    x++;
                }
            }

            b[i] = x;
            used.insert(x);
        }



        auto check = [&](int m) {
            vector<int> cnt(4 * n + 10, 0);

            for (int i = 0; i < n; i++) {
                int x = min(a[i] + m, b[i]);

                cnt[x]++;

                if (cnt[x] > k)
                    return false;
            }

            return true;
        };

        int lo = 0;
        int hi = n;

        while (lo < hi) {
            int mid = (lo + hi) / 2;

            if (check(mid)) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }

        cout << lo << '\n';
    }

    return 0;
}
