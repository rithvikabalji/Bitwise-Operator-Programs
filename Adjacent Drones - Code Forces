#include <bits/stdc++.h>
using namespace std;

// Function to compute prefix sums modulo 10
vector<int> prefixMod(const string &s) {
    vector<int> res;
    int sum = 0;
    for (char c : s) {
        sum = (sum + (c - '0')) % 10;
        res.push_back(sum);
    }
    return res;
}

// Longest Common Subsequence (space optimized)
int LCS(const vector<int> &a, const vector<int> &b) {
    int n = a.size(), m = b.size();
    vector<int> prev(m+1, 0), curr(m+1, 0);

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= m; j++) {
            if (a[i-1] == b[j-1]) curr[j] = prev[j-1] + 1;
            else curr[j] = max(prev[j], curr[j-1]);
        }
        prev = curr;
    }
    return prev[m];
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        string a, b;
        cin >> a >> b;

        vector<int> pa = prefixMod(a);
        vector<int> pb = prefixMod(b);

        int ans = LCS(pa, pb);
        if (ans == 0) cout << -1 << "\n";
        else cout << ans << "\n";
    }
    return 0;
}
